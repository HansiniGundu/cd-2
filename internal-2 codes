10TH PROGRAM 

stack.c


#include <stdio.h>
#define MAX 5

int stack[MAX];
int top = -1;

void push()
{
    int element;

    if (top == MAX - 1)
        printf("Stack Overflow\n");
    else
    {
        printf("Enter element: ");
        scanf("%d", &element);
        top++;
        stack[top] = element;
        printf("Element inserted: %d\n", element);
    }
}

void pop()
{
    if (top == -1)
        printf("Stack Underflow\n");
    else
    {
        printf("Deleted element: %d\n", stack[top]);
        top--;
    }
}

void display()
{
    int i;

    if (top == -1)
        printf("Stack is empty\n");
    else
    {
        printf("Stack elements:\n");
        for (i = top; i >= 0; i--)
            printf("%d\n", stack[i]);
    }
}

int main()
{
    int choice;

    printf("Stack Storage Allocation\n");

    while (1)
    {
        printf("\n1. PUSH");
        printf("\n2. POP");
        printf("\n3. DISPLAY");
        printf("\n4. EXIT");
        printf("\nEnter choice: ");

        scanf("%d", &choice);

        switch (choice)
        {
            case 1: push(); break;
            case 2: pop(); break;
            case 3: display(); break;
            case 4: return 0;
            default: printf("Invalid choice\n");
        }
    }

    return 0;
}


12TH PROGRAM 

first.c

#include <stdio.h>
#include <ctype.h>

char p[6][10] = {
    "E=E+T",
    "E=T",
    "T=T*F",
    "T=F",
    "F=(E)",
    "F=id"
};

void first(char c)
{
    int i;
    char x;

    if (!isupper(c))
    {
        printf("%c ", c);
        return;
    }

    for (i = 0; i < 6; i++)
    {
        if (p[i][0] == c)
        {
            x = p[i][2];

            if (x == c)
                x = p[i][3];

            if (x == '(')
                printf("( ");

            else if (x == 'i')
                printf("id ");

            else if (isupper(x))
                first(x);
        }
    }
}

int main()
{
    printf("FIRST(E) = { ");
    first('E');
    printf("}\n");

    printf("FIRST(T) = { ");
    first('T');
    printf("}\n");

    printf("FIRST(F) = { ");
    first('F');
    printf("}\n");

    return 0;
}


